<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#2D2E30"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <!-- İNDİRME ALANI - En solda, animasyonlu -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <TextView
                android:id="@+id/btnDownloadItem"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/key_bg_enter"
                android:gravity="center"
                android:text="⬇"
                android:textSize="18sp"
                android:textColor="#202124"
                android:textStyle="bold"/>

            <ProgressBar
                android:id="@+id/progressDownload"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="gone"
                android:indeterminate="true"
                android:indeterminateTint="#8AB4F8"/>

            <TextView
                android:id="@+id/tvDownloadStatus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#AA1DB954"
                android:gravity="center"
                android:text="✓"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- KAPAK -->
        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:scaleType="centerCrop"
            android:background="#3C4043"/>

        <!-- BİLGİLER -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TARKAN - Kuzu Kuzu"
                android:textColor="#E8EAED"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tarkan • 4:02"
                android:textColor="#9AA0A6"
                android:textSize="11sp"
                android:maxLines="1"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvDownloadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="İndiriliyor... %0"
                android:textColor="#8AB4F8"
                android:textSize="10sp"
                android:visibility="gone"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- SÜRE BADGE -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#3C4043"
            android:text="4:02"
            android:textColor="#E8EAED"
            android:textSize="10sp"
            android:padding="6dp"
            android:layout_marginEnd="4dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
