<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="6dp">

    <!-- ÜST BAR: Arama + İndir -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E1E"
        android:padding="8dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#2A2A2A"
            android:hint="Şarkı adı yaz... örn: tarkan kuzu kuzu"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:padding="12dp"
            android:singleLine="true"
            android:textSize="14sp"
            android:imeOptions="actionSearch" />

        <Button
            android:id="@+id/btnSearchAndType"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="YAZ"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnDownload"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="İNDİR"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1DB954"
            android:textStyle="bold"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="↓ QWERTY KLAVYE ↓"
        android:textColor="#1DB954"
        android:textSize="10sp"
        android:gravity="center"
        android:padding="4dp"
        android:background="#0A0A0A"/>

    <!-- KLAVYE TUŞLARI -->
    <GridLayout
        android:id="@+id/keyGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="10"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="false"
        android:layout_marginTop="6dp"
        android:background="#000000"
        android:padding="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎵 MusicBoard v1.0 - Arama yap ve indir"
        android:textColor="#666666"
        android:textSize="10sp"
        android:gravity="center"
        android:paddingTop="6dp"/>

</LinearLayout>
