<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎹 Music Keyboard Kurulum"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEEEEE"
        android:padding="12dp"
        android:text="Durum yükleniyor..."
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnEnableKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Klavyeyi Etkinleştir"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnStoragePerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Depolama İzni (Android 11+)"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnNotificationPerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Bildirim İzni (Android 13+)"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ YASAL UYARI:\nBu klavye sadece telifsiz, kendi ürettiğiniz veya indirme izni olan müzikler için kullanılmalıdır. Spotify, YouTube Music, Apple Music gibi platformlardan DRM korumalı içerik indirmek telif hakkı ihlalidir.\n\nÖnerilen yasal API'lar: Jamendo, Free Music Archive, kendi sunucunuz."
        android:textSize="11sp"
        android:textColor="#AA0000"
        android:background="#FFF3CD"
        android:padding="10dp"/>

</LinearLayout>
